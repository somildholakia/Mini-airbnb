<% layout("/layouts/boilerplate") %>
<section class="listing-detail hotel-detail">
  <div class="listing-detail-heading">
    <span class="wander-eyebrow"><%= singleListing.isCurated ? "WANDERSITE EDITORIAL HOTEL PROFILE" : "WANDERSITE · COMMUNITY STAY" %></span>
    <h1><%= singleListing.title %></h1>
    <p><i class="fa-solid fa-location-dot"></i> <%= [singleListing.location, singleListing.country].filter(Boolean).join(", ") %><% if (singleListing.category) { %><span class="detail-category-dot">·</span> <%= singleListing.category %><% } %></p>
    <% if (currUser) { %>
      <form class="save-stay-form" method="POST" action="<%= isSaved ? '/saved/' + singleListing._id + '/remove' : '/saved/' + singleListing._id %>">
        <input type="hidden" name="returnTo" value="/listings/<%= singleListing._id %>">
        <button class="save-stay-button <%= isSaved ? 'is-saved' : '' %>" type="submit"><i class="fa-<%= isSaved ? 'solid' : 'regular' %> fa-heart"></i> <%= isSaved ? 'Saved to your trip list · Remove' : 'Save to your trip list' %></button>
      </form>
    <% } else { %>
      <a class="save-stay-button" href="/login?returnTo=/listings/<%= singleListing._id %>"><i class="fa-regular fa-heart"></i> Log in to save this stay</a>
    <% } %>
  </div>
  <div class="listing-detail-grid">
    <div class="hotel-detail-photo-wrap">
      <img src="<%= singleListing.image && singleListing.image.url ? singleListing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=82' %>" class="listing-detail-image" alt="Editorial destination image for <%= singleListing.title %>">
      <% if (singleListing.isCurated && singleListing.imageDisclaimer) { %><small class="image-note"><%= singleListing.imageDisclaimer %></small><% } %>
    </div>
    <div class="listing-detail-copy hotel-detail-copy">
      <% if (singleListing.isCurated) { %>
        <span class="detail-label">WanderSite hotel collection</span><h3>Discover the property</h3><p><%= singleListing.description %></p>
        <% if (singleListing.rankingYear === 2026 && singleListing.curationRank) { %><div class="ranking-recognition"><i class="fa-solid fa-award"></i> Ranked #<%= singleListing.curationRank %> in The 50 Best Hotels 2026</div><% } %>
        <div class="hotel-profile-facts">
          <div><span>Stay style</span><strong><%= singleListing.category || "Hotel" %></strong></div>
          <div><span>Destination</span><strong><%= [singleListing.location, singleListing.country].filter(Boolean).join(", ") %></strong></div>
          <div><span>Rates & availability</span><strong>Confirm with the hotel</strong></div>
          <% if (singleListing.rankingYear === 2026) { %><div><span>Recognition source</span><strong>The 50 Best Hotels 2026</strong></div><% } %>
        </div>
        <a class="hotel-outbound-button" href="<%= singleListing.hotelSearchUrl || 'https://www.google.com/search?q=' + encodeURIComponent(singleListing.title + ' ' + singleListing.location + ' official hotel website') %>" target="_blank" rel="noopener noreferrer">Find hotel details & rates <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        <small class="hotel-outbound-note">Opens an external search to find current official information. WanderSite does not process hotel bookings or verify live rates.</small>
      <% } else { %>
        <span class="detail-label">Hosted by</span><h3><%= singleListing.owner ? singleListing.owner.username : "WanderSite host" %></h3>
        <p><%= singleListing.description %></p>
        <div class="listing-detail-price"><strong>₹<%= Number(singleListing.price || 0).toLocaleString("en-IN") %></strong><span>/ night · host-provided price</span></div>
      <% } %>
      <% if (!singleListing.isCurated && currUser && singleListing.owner && String(currUser._id) === String(singleListing.owner._id)) { %>
        <div class="listing-owner-actions"><a href="/listings/<%= singleListing._id %>/edit" class="btn btn-dark">Edit listing</a>
          <form method="post" action="/listings/<%= singleListing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing? This cannot be undone.');"><button class="btn btn-outline-danger" type="submit">Delete</button></form>
        </div>
      <% } %>
    </div>
  </div>

  <section class="listing-location-panel">
    <div class="section-title-row"><div><span class="wander-eyebrow">GET TO KNOW THE AREA</span><h2>Explore the destination</h2></div></div>
    <% if (mapCoordinates && mapCoordinates.length === 2) { %>
      <div id="listing-detail-map" class="wander-map detail-map" data-coordinates="<%= mapCoordinates.join(',') %>" data-title="<%= singleListing.title %>" data-location="<%= [singleListing.location, singleListing.country].filter(Boolean).join(', ') %>" role="region" aria-label="Approximate map location for this stay"></div>
      <p class="map-disclaimer"><i class="fa-solid fa-location-dot"></i> This pin marks the approximate city or destination area. The property's exact address is not shown.</p>
    <% } else { %><div class="map-unavailable">Map coordinates are not available for this location yet.</div><% } %>
  </section>

  <section class="listing-reviews">
    <div class="section-title-row"><div><span class="wander-eyebrow">COMMUNITY NOTES</span><h2>Guest reviews</h2><p>Reviews are community-submitted and are not verified booking records.</p></div></div>
    <% if (currUser) { %>
      <form class="review-form needs-validation" action="/listings/<%= singleListing._id %>/reviews" method="POST" novalidate>
        <fieldset class="starability-slot"><legend>Your rating</legend>
          <% for (let rating = 1; rating <= 5; rating++) { %><input type="radio" id="rate<%= rating %>" name="review[rating]" value="<%= rating %>" <%= rating === 5 ? "required" : "" %>><label for="rate<%= rating %>"><%= rating %> star<%= rating > 1 ? "s" : "" %></label><% } %>
        </fieldset>
        <div class="mb-3 mt-3"><label for="comment" class="form-label">Share your experience</label><textarea name="review[comment]" id="comment" rows="4" class="form-control" required maxlength="1500"></textarea><div class="invalid-feedback">Please add a comment.</div></div>
        <button class="btn btn-dark" type="submit">Post review</button>
      </form>
    <% } else { %><p class="review-signin-note"><a href="/login">Log in</a> to leave a community review.</p><% } %>
    <% if (singleListing.reviews.length === 0) { %><p class="map-empty-state">No reviews yet. Be the first to share a useful note.</p>
    <% } else { %>
      <div class="review-grid">
        <% for (const review of singleListing.reviews) { %>
          <article class="review-card"><div class="review-card-rating"><i class="fa-solid fa-star"></i> <%= review.rating %>/5</div><p><%= review.comment %></p>
            <small class="review-author"><%= review.owner ? review.owner.username : "WanderSite traveller" %> · <%= new Date(review.createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></small>
            <% if (currUser && review.owner && String(currUser._id) === String(review.owner._id)) { %><form method="post" action="/listings/<%= singleListing._id %>/reviews/<%= review._id %>?_method=DELETE"><button class="btn btn-sm btn-link text-danger" type="submit">Delete review</button></form><% } %>
          </article>
        <% } %>
      </div>
    <% } %>
  </section>
</section>
