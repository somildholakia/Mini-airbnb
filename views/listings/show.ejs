<% layout("/layouts/boilerplate") %>

<section class="listing-detail">
    <div class="listing-detail-heading">
        <span class="wander-eyebrow">WANDERSITE · YOUR NEXT ESCAPE</span>
        <h1><%= singleListing.title %></h1>
        <p><i class="fa-solid fa-location-dot"></i> <%= [singleListing.location, singleListing.country].filter(Boolean).join(", ") %></p>
    </div>

    <div class="listing-detail-grid">
        <img
            src="<%= singleListing.image && singleListing.image.url ? singleListing.image.url : 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1200&q=80' %>"
            class="listing-detail-image"
            alt="<%= singleListing.title %>">

        <div class="listing-detail-copy">
            <span class="detail-label">Hosted by</span>
            <h3><%= singleListing.owner ? singleListing.owner.username : "WanderSite host" %></h3>
            <p><%= singleListing.description %></p>
            <div class="listing-detail-price">
                <strong>₹<%= Number(singleListing.price || 0).toLocaleString("en-IN") %></strong>
                <span>/ night</span>
            </div>

            <% if (currUser && singleListing.owner && String(currUser._id) === String(singleListing.owner._id)) { %>
                <div class="listing-owner-actions">
                    <a href="/listings/<%= singleListing._id %>/edit" class="btn btn-dark">Edit listing</a>
                    <form method="post" action="/listings/<%= singleListing._id %>?_method=DELETE">
                        <button class="btn btn-outline-danger" type="submit">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>

    <section class="listing-location-panel">
        <div class="wander-section-heading">
            <div>
                <span class="wander-eyebrow">GET TO KNOW THE AREA</span>
                <h2>Explore the location</h2>
            </div>
        </div>
        <% if (mapCoordinates && mapCoordinates.length === 2) { %>
            <div id="listing-detail-map"
                 class="wander-map detail-map"
                 data-coordinates="<%= mapCoordinates.join(',') %>"
                 data-title="<%= singleListing.title %>"
                 data-location="<%= [singleListing.location, singleListing.country].filter(Boolean).join(', ') %>"
                 role="region"
                 aria-label="Approximate map location for this stay"></div>
            <p class="map-disclaimer"><i class="fa-solid fa-location-dot"></i> This pin marks the approximate city area. The property's exact address is not shown.</p>
        <% } else { %>
            <div class="map-unavailable">Map coordinates are not available for this location yet.</div>
        <% } %>
    </section>

    <section class="listing-reviews">
        <div class="wander-section-heading">
            <div>
                <span class="wander-eyebrow">GUEST NOTES</span>
                <h2>Reviews</h2>
            </div>
        </div>

        <% if (currUser) { %>
            <form class="review-form needs-validation"
                  action="/listings/<%= singleListing._id %>/reviews"
                  method="POST"
                  novalidate>
                <fieldset class="starability-slot">
                    <legend>Rating</legend>
                    <% for (let rating = 1; rating <= 5; rating++) { %>
                        <input type="radio" id="rate<%= rating %>" name="review[rating]" value="<%= rating %>" <%= rating === 5 ? "required" : "" %>>
                        <label for="rate<%= rating %>"><%= rating %> star<%= rating > 1 ? "s" : "" %></label>
                    <% } %>
                </fieldset>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Your experience</label>
                    <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add a comment.</div>
                </div>
                <button class="btn btn-dark" type="submit">Post review</button>
            </form>
        <% } else { %>
            <p class="review-signin-note"><a href="/login">Log in</a> to leave a review.</p>
        <% } %>

        <% if (singleListing.reviews.length === 0) { %>
            <p class="map-empty-state">No reviews yet. Be the first to share your experience.</p>
        <% } else { %>
            <div class="review-grid">
                <% for (const review of singleListing.reviews) { %>
                    <article class="review-card">
                        <div class="review-card-rating"><i class="fa-solid fa-star"></i> <%= review.rating %>/5</div>
                        <p><%= review.comment %></p>
                        <% if (currUser && review.owner && String(currUser._id) === String(review.owner)) { %>
                            <form method="post" action="/listings/<%= singleListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-link text-danger" type="submit">Delete review</button>
                            </form>
                        <% } %>
                    </article>
                <% } %>
            </div>
        <% } %>
    </section>
</section>
