<head>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">
</head>

<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3><%= singleListing.title %></h3>
    </div>

    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= singleListing.image.url %>" class="card-img-top show-img" alt="listing-image">
        <div class="card-body">
            <p class="card-text">
                <i><b>Owner:</b> <%= singleListing.owner.username %></i><br>
                <%= singleListing.description %> <br>
                &#8377; <%= singleListing.price.toLocaleString("en-IN") %> <br>
                <%= singleListing.location %> <br>
                <%= singleListing.country %>
            </p>
        </div>
    </div>
</div>

<div class="btns">
    <a href="/listings/<%= singleListing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

    <form method="post" action="/listings/<%= singleListing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">DELETE</button>
    </form>
</div>

<div class="col-8 offset-3">
    <hr>
    <h4>Leave a Review</h4>

    <!-- ✅ FIXED FORM -->
    <form class="col-8 mb-3 needs-validation"
          action="/listings/<%= singleListing._id %>/reviews"
          method="POST"
          novalidate>

        <!-- ⭐ FIX: ONLY ONE rating input -->
        <fieldset class="starability-slot">
            <legend>Rating:</legend>

            <input type="radio" id="rate1" name="review[rating]" value="1" required>
            <label for="rate1">1 star</label>

            <input type="radio" id="rate2" name="review[rating]" value="2">
            <label for="rate2">2 stars</label>

            <input type="radio" id="rate3" name="review[rating]" value="3">
            <label for="rate3">3 stars</label>

            <input type="radio" id="rate4" name="review[rating]" value="4">
            <label for="rate4">4 stars</label>

            <input type="radio" id="rate5" name="review[rating]" value="5">
            <label for="rate5">5 stars</label>
        </fieldset>

        <!-- COMMENT -->
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea name="review[comment]"
                      id="comment"
                      cols="30"
                      rows="5"
                      class="form-control"
                      required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr>
    <p><b>All reviews</b></p>

    <div class="row">
        <% for(let review of singleListing.reviews) { %>
            <div class="card col-5 ms-3 mb-3">
                <div class="card-body">
                    <h5 class="card-title">User</h5>
                    <p class="card-text"><%= review.comment %></p>
                    <p class="card-text"><%= review.rating %> Stars</p>

                    <form method="post"
                          action="/listings/<%= singleListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
</div>