<% layout("/layouts/boilerplate") %>
<section class="trip-invite-page">
  <div class="trip-invite-card">
    <span class="wander-eyebrow">TRAVEL TOGETHER</span>
    <div class="trip-invite-icon"><i class="fa-solid fa-user-group"></i></div>
    <h1>You're invited to collaborate</h1>
    <h2><%= trip.title %></h2>
    <p><i class="fa-solid fa-location-dot"></i> <%= trip.destination || "Destination not set" %></p>
    <% if (alreadyMember) { %>
      <p class="trip-invite-note">You're already a member of this trip.</p>
      <a class="wander-primary-link" href="/trips">Go to my trips <i class="fa-solid fa-arrow-right"></i></a>
    <% } else { %>
      <p class="trip-invite-note">Join this itinerary to add stays, update the plan and coordinate with the trip owner.</p>
      <form method="POST" action="/trips/invite/<%= encodeURIComponent(req.params.token) %>/accept">
        <button class="btn btn-dark px-4" type="submit">Join trip <i class="fa-solid fa-arrow-right ms-1"></i></button>
      </form>
    <% } %>
  </div>
</section>
